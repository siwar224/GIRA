# Copy to .env.local for local development (never commit real values).

# ── Public (inlined into the browser bundle) ──────────────────────────────────
# Canonical origin used for metadata, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=https://gira.example

# ── Server only (never prefix these with NEXT_PUBLIC_) ────────────────────────
# Neon Postgres. The Vercel ↔ Neon integration sets both automatically.
# Pooled connection, used by the API at runtime:
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Direct connection, used by `npm run db:migrate` (falls back to DATABASE_URL):
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Secret (32+ characters) mixed into IP hashes for rate limiting. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=replace-with-64-hex-characters-from-the-command-above

# true = show believable "already booked" tables on top of real bookings (demo).
# false/empty = only real bookings count.
DEMO_OCCUPANCY=true
